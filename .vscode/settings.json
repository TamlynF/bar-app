{
  "css.lint.unknownAtRules": "ignore",
  "workbench.colorTheme": "Dark 2026",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.includeLanguages": {
    "plaintext": "html"
  },
  "html.suggest.hideEndTagSuggestions": true,
  "tailwindcss-intellisense.trace.server": "messages",
  "tailwindCSS.experimental.configFile": "src/app/globals.css",
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "notebook.defaultFormatter": "dbaeumer.vscode-eslint",
  "eslint.debug": true,
  // No formatter runs on save — nothing rewrites Tailwind classes while you edit.
  // Class ordering is deliberately not enforced (see eslint.config.mjs); the
  // pre-commit hook still runs `eslint --fix` for unused-imports + fails loudly on
  // conflicting/unknown classes. If classes still get reordered on save, an
  // external extension (e.g. Headwind) or an AI edit tool is doing it — disable it.
  "editor.formatOnSave": false,
  "eslint.format.enable": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false
  },
  "[typescript]": {
    "editor.formatOnSave": false
  },
  "eslint.lintTask.enable": true,
  "eslint.useESLintClass": true,
  "npm.packageManager": "npm",
  "tailwindCSS.classFunctions": [
    "cn",
    "cva",
    "clsx"
  ],
  "tailwindCSS.emmetCompletions": true,
  "[tailwindcss]": {
    "editor.defaultFormatter": "numso.prettier-standard-vscode"
  }
}